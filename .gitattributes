# Source text follows the checkout's configured line endings.
* text=auto

# Publication hashes refer to exact bytes, on Windows and on Linux.
artifacts/** binary

# Pinned upstream assets and their integrity tests also require exact bytes.
packages/tools/ai/assets/** -text -whitespace
packages/render-three/vendor/** -text -whitespace

# The builtin catalog records the exact bytes of these text assets too.
modules/logistica-industrial/assets/materials/pbr/LICENSE.txt -text
modules/logistica-industrial/assets/materials/pbr/manifest.json -text
modules/turismo/assets/tweets.json -text
